# Copy this file to .env and fill in your key. .env is git-ignored, so it never gets committed.
ANTHROPIC_API_KEY=your-key-here
# Optional: override the default model
# LLM_MODEL=claude-haiku-4-5-20251001
# Optional (Phase 6): traffic.py also writes every trace to this folder. Put it outside
# OneDrive to check whether the sync loses traces (see README, "The OneDrive test").
# KESTREL_TRACES_COPY_DIR=C:\Users\you\kestrel-traces
